PORT=4000
NODE_ENV=development
# Mantenha 0 sem proxy. 1..5 somente com topologia conhecida e validada.
TRUST_PROXY_HOPS=0
DB_URI=mongodb://127.0.0.1:27017/fetech
JWT_SECRET=substitua-por-uma-chave-aleatoria
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
# CSRF e links de recuperação. Production exige URL HTTPS absoluta sem credenciais.
# Somente a origin é permitida; Host e X-Forwarded-Host não definem a allowlist.
FRONTEND_URL=http://localhost:3000

# Necessario para cadastro com upload de avatar.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Necessario para envio de emails de recuperacao de senha.
HOST=
PORTEMAIL=465
EMAIL_SECURE=true
USER=
PASSWORD=
