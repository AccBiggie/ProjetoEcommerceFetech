PORT=4000
NODE_ENV=development
# Sem proxy: 0. 1..5 apenas com topologia validada (F023).
TRUST_PROXY_HOPS=0
# Database explícita em todos os perfis. Production não aceita database test.
DB_URI=mongodb://127.0.0.1:27017/fetech
# Não existe secret default. Gere e substitua o placeholder antes de iniciar.
# Production exige >=32 bytes, sem placeholders ou whitespace nas extremidades.
JWT_SECRET=<gere-um-segredo-forte>
JWT_EXPIRE=7d
# Duração positiva em dias; data final deve ser representável.
COOKIE_EXPIRE=7
# Links de recuperação e allowlist CSRF. Production exige HTTPS explícito.
# Paths são normalizados para origin, preservando o contrato F020.
FRONTEND_URL=http://localhost:3000
# Inteiro 0..5000 ms. Default 300; valor inválido impede startup.
AUTH_FORGOT_MIN_RESPONSE_MS=300

# Opcional: sem foto funciona sem Cloudinary. Se preencher um, preencha os três.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP opcional em development/test e obrigatório completo em production.
# Deixe TODO o grupo vazio para desenvolvimento sem e-mail.
# HOST é hostname; PORTEMAIL é inteiro 1..65535; USER é usuário/remetente.
# PASSWORD deve vir do ambiente seguro, sem senha default.
HOST=
PORTEMAIL=
USER=
PASSWORD=
# Opcional junto do transporte: true ou false; default é PORTEMAIL == 465.
EMAIL_SECURE=
